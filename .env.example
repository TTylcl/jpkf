# ===========================================
# AI Agent 教务系统 - 环境变量配置模板
# 复制此文件为 .env 并填入真实值
# cp .env.example .env
# ===========================================

# ── LLM 配置（火山方舟，OpenAI 兼容接口）──
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
LLM_BASE_DATA_URL=https://ark.cn-beijing.volces.com/api/v3/
LLM_MODEL=ep-xxx-xxx            # 火山方舟推理接入点 ID（Endpoint）
LLM_TIMEOUT=30

# ── Embedding 模型（阿里云百炼 MaaS，OpenAI 兼容接口）──
EMBEDDING_API_KEY=sk-your-api-key-here
EMBEDDING_BASE_URL=https://ws-xxx.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4

# ── 可观测性（可选）──
ENABLE_OBSERVABILITY=True
DAILY_TOKEN_BUDGET=500000
COST_ALERT_THRESHOLD=0.85

# ── 日志 ──
LOG_LEVEL=DEBUG

# ── 数据库（PostgreSQL + pgvector）──
DB_HOST=localhost
DB_PORT=5434
DB_NAME=test_database
DB_USER=postgres
DB_PASSWORD=your-db-password
# compose.yml 容器初始化用（需与 DB_PASSWORD 保持一致）
POSTGRES_PASSWORD=your-db-password